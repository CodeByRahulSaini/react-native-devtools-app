import("../../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../../scripts/build/ninja/devtools_module.gni")
import("../../../../scripts/build/ninja/generate_css.gni")
import("../../../../front_end/panels/visibility.gni")

generate_css("css_files") {
  sources = [ "rnNetwork.css" ]
}

devtools_module("rn_network") {
  sources = [
    "RNNetworkModel.ts",
    "RNNetworkPanel.ts",
  ]

  deps = [
    "../../../../front_end/core/i18n:bundle",
    "../../../../front_end/core/root:bundle",
    "../../../../front_end/core/sdk:bundle",
    "../../../../front_end/ui/legacy:bundle",
    "../../../../front_end/ui/lit:bundle",
    "../../models/plugins_bindings:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "rn_network.ts"

  deps = [
    ":css_files",
    ":rn_network",
  ]

  visibility = [
    ":*",
    "../../../../front_end/entrypoints/*",
  ]

  visibility += devtools_panels_visibility
}

devtools_entrypoint("meta") {
  entrypoint = "rn_network-meta.ts"

  deps = [ ":bundle" ]

  visibility = [ "../../../../front_end/entrypoints/rn_fusebox/*" ]
}


